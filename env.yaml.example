# ===============================================
# env.yaml.example — pharma-hub
# Referência de todas as variáveis de ambiente.
# ===============================================
#
# COMO USAR:
#   1. Copie para env.yaml: cp env.yaml.example env.yaml
#   2. Preencha os valores reais
#   3. NUNCA commite o env.yaml — ele está no .gitignore
#
# ESTRUTURA NO GCP:
#   - Variáveis simples: passadas via --set-env-vars no Cloud Build
#   - Secrets (senhas, API Keys): passadas via --set-secrets do Secret Manager
#
# SECRETS NECESSÁRIOS NO SECRET MANAGER (criar uma vez por projeto GCP):
#   pharmahub_db_url         → jdbc:postgresql://HOST:5432/
#   pharmahub_db_user        → usuário do banco
#   pharmahub_db_password    → senha do banco
#   pharmahub_api_key_pharma_app       → API Key do cliente pharma-app
#   pharmahub_api_key_admin_dashboard  → API Key do cliente admin-dashboard
#
# ===============================================

# Banco de Dados
DATABASE_URL: "jdbc:postgresql://localhost:5432/pharmahub_dev"
DATABASE_USER: "postgres"
DATABASE_PASSWORD: "postgres"

# API Keys dos clientes (em prod vêm do Secret Manager)
QUERYHUB_API_KEY_PHARMA_APP: "sua-api-key-aqui"
QUERYHUB_API_KEY_ADMIN_DASHBOARD: "outra-api-key-aqui"

# Logging
LOG_LEVEL: "INFO"
LOG_JSON: "true"
GCP_LOGGING_ENABLED: "true"

