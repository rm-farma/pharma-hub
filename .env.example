# ================================================
# Exemplo de variaveis de ambiente - pharma-hub
# Copie para .env: cp .env.example .env
#
# ATENCAO: NUNCA commite o .env com valores reais.
#          Ele ja esta no .gitignore.
# ================================================
# Banco de Dados PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/pharmahub_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# API Keys dos clientes (apenas referencia - em dev estao hardcoded no application-dev.properties)
# Em prod, estas vem do Secret Manager via Cloud Build (--set-secrets)
QUERYHUB_API_KEY_PHARMA_APP=sua-api-key-aqui
QUERYHUB_API_KEY_ADMIN_DASHBOARD=outra-api-key-aqui
# Logging
LOG_LEVEL=DEBUG
LOG_JSON=false
