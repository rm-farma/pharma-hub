# ================================================
# Exemplo de variaveis de ambiente - pharma-hub
# Copie para .env: cp .env.example .env
#
# ATENCAO: NUNCA commite o .env com valores reais.
#          Ele ja esta no .gitignore.
#
# Para pegar os valores reais do banco de dev:
#   gcloud secrets versions access latest --secret=pharmamanager_db_host --project=rmfarma-dev
#   gcloud secrets versions access latest --secret=pharmamanager_db_user --project=rmfarma-dev
#   gcloud secrets versions access latest --secret=pharmamanager_db_password --project=rmfarma-dev
# ================================================

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://HOST_DO_BANCO:5432/
DB_NAME=postgres
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
# Logging
LOG_LEVEL=DEBUG
LOG_JSON=false
