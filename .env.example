# ===============================================
# Exemplo de variáveis de ambiente — pharma-hub
# Copie este arquivo para .env e preencha os valores
# Comando: cp .env.example .env
#
# ⚠️ NUNCA commite o .env com valores reais.
#    Ele já está no .gitignore.
# ===============================================

# -----------------------------------------------
# Banco de Dados PostgreSQL (BigQuery via JDBC)
# -----------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/pharmahub_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# -----------------------------------------------
# Segurança — API Keys dos clientes
# -----------------------------------------------
# Chaves para o perfil dev (sobrescreve o application-dev.properties)
# Em prod, estas variáveis vêm do Cloud Build via --set-secrets ou --set-env-vars
QUERYHUB_API_KEY_PHARMA_APP=sua-api-key-aqui
QUERYHUB_API_KEY_ADMIN_DASHBOARD=outra-api-key-aqui

# -----------------------------------------------
# Google Cloud (apenas se usar Secret Manager no futuro)
# -----------------------------------------------
# GCP_PROJECT_ID=rm-farma-dev
# GCP_LOGGING_ENABLED=false

# -----------------------------------------------
# Logging
# -----------------------------------------------
LOG_LEVEL=DEBUG
LOG_JSON=false

